@app.route('/')
def home():
    search_query = request.args.get('search', '')
    conn = get_db_connection()
    cursor = conn.cursor()
    
    if search_query:
        cursor.execute("SELECT * FROM books WHERE title LIKE ? OR category LIKE ?", (f'%{search_query}%', f'%{search_query}%'))
    else:
        cursor.execute("SELECT * FROM books")
        
    books = cursor.fetchall()
    conn.close()
    return render_template_string(HTML_TEMPLATE, books=books, search_query=search_query)

@app.route('/issue', methods=['POST'])
def issue_book():
    trans_id = request.form['trans_id']
    book_id = request.form['book_id']
    member_id = request.form['member_id']
    
    conn = get_db_connection()
    cursor = conn.cursor()
    
    # Check if book exists and is available[cite: 1]
    cursor.execute("SELECT status FROM books WHERE book_id = ?", (book_id,))
    book = cursor.fetchone()
    
    if not book:
        flash('Error: Book ID not found!', 'danger')
    elif book['status'] == 'Issued':
        flash('Warning: Book is currently not available!', 'warning')[cite: 1]
    else:
        issue_date = datetime.now().strftime('%Y-%m-%d')
        due_date = (datetime.now() + timedelta(days=14)).strftime('%Y-%m-%d')[cite: 1]
        
        cursor.execute("INSERT INTO book_transactions VALUES (?, ?, ?, ?, ?, NULL, 'Issued')", 
                       (trans_id, book_id, member_id, issue_date, due_date))[cite: 1]
        cursor.execute("UPDATE books SET status = 'Issued' WHERE book_id = ?", (book_id,))[cite: 1]
        conn.commit()
        flash('Success: Book issued successfully!', 'success')[cite: 1]
        
    conn.close()
    return redirect(url_for('home'))

# Initialize database on application start
init_db()

if __name__ == '__main__':
    app.run(host='0.0.0.0', port=5000, debug=True)
